# ==========================================
# SpendLite — Expense Tracker Environment Configuration
# ==========================================

# PostgreSQL Database Configuration
POSTGRES_USER=spendlite_user
POSTGRES_PASSWORD=spendlite_password
POSTGRES_DB=spendlite_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://spendlite_user:spendlite_password@db:5432/spendlite_db

# Redis Cache Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_TTL=60

# Backend Configuration
DATA_FILE_PATH=/app/data/expenses.json
CORS_ORIGINS=*

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000
